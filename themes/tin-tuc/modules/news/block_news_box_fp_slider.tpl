<!-- BEGIN: main -->
<div class="box-fp-slider section">
<div class="block">
<div class="block-content">

<div id="small-section-wrap">
<!-- BEGIN: small_row -->
<div class="small-section top-small">
		<a href="{ROW.link}" title="{ROW.title}"><img alt="{ROW.title}" src="{ROW.thumb}"></a>
	<div class="feat-cap"><a href="{ROW.link}" title="{ROW.title}">{ROW.title_clean}</a></div>
</div>
<!-- END: small_row -->
</div>

<div class="wrapper">
<div class="owl-nav-box"><div class="owl-prev-box"></div><div class="owl-next-box"></div></div>
<div class="box-carousel owl-carousel">
<!-- BEGIN: large_row -->
<div id="large-section" class="fadeUp">
		<a href="{ROW.link}" title="{ROW.title}"><img alt="{ROW.title}" src="{ROW.thumb}"></a>
		<h2>{ROW.cat_title}</h2>
		<div class="feat-cap">
		<a href="{ROW.link}" title="{ROW.title}"><h3 class="post-title">{ROW.title_clean}</h3></a>
		<div class="metainfo">
	<span><i class="fa fa-user"></i> {ROW.author}</span>
	<span><i class="fa fa-calendar"></i> {ROW.publtime}</span>
	<span><i class="fa fa-eye"></i> {ROW.hitstotal}</span>
		</div>
		</div>
	</div>
<!-- END: large_row -->
</div></div>
</div></div></div>
<!-- END: main -->
