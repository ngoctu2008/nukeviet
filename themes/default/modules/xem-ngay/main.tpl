                    <h5 class="card-title">{LANG.wedding_title}</h5>
                    <p class="card-text">Xem ngày cưới hỏi, nạp tài, rước dâu.</p>
                    <a href="#" class="btn btn-secondary disabled">Sắp ra mắt</a>
