<!-- BEGIN: main -->
<div class="box-video"><div class="block"><div class="block-content">

<div class="small-section-wrap">
<!-- BEGIN: small_row -->
<div class="small-section top-small">
	<img alt="{ROW.title}" src="{ROW.thumb}">
	<a href="{ROW.link}" title="{ROW.title}"><span class="youtubeplay"><i class="fa fa-play-circle-o"></i></span></a>
	<div class="feat-cap">
		<a href="{ROW.link}" title="{ROW.title}">{ROW.title_clean}</a><span><i class="fa fa-eye"></i> {ROW.hitstotal}</span>
	</div>
</div>
<!-- END: small_row -->
</div>

<div id="large-section" class="fadeUp">
    <!-- BEGIN: large_row -->
	<div class="img-hover">
	<img alt="{ROW.title}" src="{ROW.thumb}">
	<a href="{ROW.link}" title="{ROW.title}"><span class="youtubeplay"><i class="fa fa-play-circle-o"></i></span></a>
	</div>
	<a href="{BLOCK_LINK}" title="{BLOCK_TITLE}"><h2>{BLOCK_TITLE}</h2></a>

	<div class="feat-cap">
		<a href="{ROW.link}" title="{ROW.title}"><h3 class="post-title">{ROW.title_clean}</h3></a>
		<div class="metainfo">
		<span><i class="fa fa-calendar"></i> {ROW.publtime}</span>
		<span><i class="fa fa-eye"></i> {ROW.hitstotal}</span>
		</div>
	</div>
    <!-- END: large_row -->
</div>

</div></div></div>
<!-- END: main -->
