<!-- BEGIN: main -->
	<div class="mastoras_narrow">
<!-- BEGIN: row -->
		<div class="thumb">
			<a title="{ROW.title}" href="{ROW.link}">
			<img class="alignright" alt="{ROW.title}" src="{ROW.thumb}">
			</a>
		</div>
		<div class="featuredTitle">
			<a title="{ROW.title}" href="{ROW.link}">{ROW.title}</a>
			<div class="metainfo" style="margin: 10px 0 0 0">
				<span><i class="fa fa-calendar"></i> {ROW.publtime}</span>
				<span><i class="fa fa-eye"></i> {ROW.hitstotal}</span>
			</div>
		</div>
	<div class="clear"></div>
<!-- END: row -->
	</div>
<!-- END: main -->
